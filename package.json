{
  "name": "edtech-musical-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma EdTech musical multi-instrumentos (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "@scarf/scarf": false,
    "unrs-resolver@1.12.2": true
  }
}
