# ==========================================================================
# .env.example — nenhuma credencial real deve ser preenchida aqui.
# Copie para .env (ou .env.local) e preencha por ambiente (dev/homolog/prod).
# ==========================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_musical?schema=public

# --- Auth (JWT) ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- Redis (cache / rate limit / filas) ---
REDIS_URL=redis://localhost:6379

# --- Storage (S3-compatible: AWS S3 / Cloudflare R2) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Vídeo / Streaming (abstraído via VideoProvider) ---
VIDEO_PROVIDER=mux
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_SECRET=

# --- Pagamentos (abstraído via PaymentGateway) ---
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- E-mail (notificações) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
