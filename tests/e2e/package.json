{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Testes E2E cross-app: os 8 fluxos principais (cadastro -> login -> assinatura -> acesso ao curso -> reproducao -> progresso -> conclusao -> cancelamento) via HTTP contra um apps/api real e seedado (FASE 12).",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest"
  },
  "dependencies": {
    "shared": "0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
