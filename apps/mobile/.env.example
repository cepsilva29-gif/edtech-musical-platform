# Copie para .env nesta pasta (apps/mobile/.env) antes de rodar o app.
# Variaveis EXPO_PUBLIC_* ficam embutidas no bundle JS - nunca coloque segredos aqui.

# URL base da API (apps/api), incluindo o prefixo /api/v1.
# - Simulador iOS / web: http://localhost:3000/api/v1
# - Emulador Android:    http://10.0.2.2:3000/api/v1
# - Dispositivo fisico:  http://<IP-da-maquina-na-rede-local>:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
