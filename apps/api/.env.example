# Copie para .env nesta pasta (apps/api/.env) antes de rodar a API ou comandos Prisma.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_musical?schema=public

# Gere segredos fortes e distintos para cada ambiente, ex.: `openssl rand -base64 48`
JWT_SECRET=troque-por-um-segredo-forte-de-desenvolvimento
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-desenvolvimento
JWT_REFRESH_EXPIRES_IN=30d

# Origens permitidas para CORS, separadas por virgula (ex.: http://localhost:3001,http://localhost:19006)
CORS_ORIGIN=*
