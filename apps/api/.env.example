# Copie para .env nesta pasta (apps/api/.env) antes de rodar a API ou comandos Prisma.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_musical?schema=public

# Gere segredos fortes e distintos para cada ambiente, ex.: `openssl rand -base64 48`
JWT_SECRET=troque-por-um-segredo-forte-de-desenvolvimento
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-desenvolvimento
JWT_REFRESH_EXPIRES_IN=30d

# Origens permitidas para CORS, separadas por virgula (ex.: http://localhost:3001,http://localhost:19006)
CORS_ORIGIN=*

# Gateway de pagamento (FASE 6). Somente "fake" (dev/simulacao, sem chamadas externas) esta
# implementado nesta fase - ver docs/ARCHITECTURE.md e apps/api/README.md.
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_GATEWAY_SECRET=troque-por-um-segredo-de-desenvolvimento

# Provedor de video/streaming (FASE 7). Somente "fake" (dev/simulacao, sem chamadas externas) esta
# implementado nesta fase - ver docs/ARCHITECTURE.md e apps/api/README.md.
VIDEO_PROVIDER=fake
FAKE_VIDEO_PROVIDER_SECRET=troque-por-um-segredo-de-desenvolvimento
VIDEO_PLAYBACK_URL_TTL_SECONDS=600

# Provedor de live/streaming ao vivo (FASE 9). Somente "fake" (dev/simulacao, sem chamadas
# externas) esta implementado nesta fase - ver docs/ARCHITECTURE.md e apps/api/README.md.
LIVE_PROVIDER=fake
FAKE_LIVE_PROVIDER_SECRET=troque-por-um-segredo-de-desenvolvimento
LIVE_RECORDING_URL_TTL_SECONDS=600
