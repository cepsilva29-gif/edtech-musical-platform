# Copie para .env.test.local nesta pasta (apps/api/.env.test.local) antes de rodar
# `npm run test:integration`. NUNCA aponte para o mesmo banco do .env de desenvolvimento - os
# testes de integracao truncam TODAS as tabelas entre arquivos de teste (ver
# test/utils/reset-database.ts), e a propria funcao se recusa a rodar se o nome do banco nao
# terminar em "_test", exatamente para evitar apagar dados de verdade por engano.

NODE_ENV=test
PORT=3001

# Suba um Postgres descartavel so para isto, ex.:
#   docker run --rm -p 5433:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=edtech_musical_test postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/edtech_musical_test?schema=public

JWT_SECRET=segredo-de-teste-nao-usar-em-outro-ambiente
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-de-teste-nao-usar-em-outro-ambiente
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*

PAYMENT_PROVIDER=fake
FAKE_PAYMENT_GATEWAY_SECRET=segredo-de-teste

VIDEO_PROVIDER=fake
FAKE_VIDEO_PROVIDER_SECRET=segredo-de-teste
VIDEO_PLAYBACK_URL_TTL_SECONDS=600

LIVE_PROVIDER=fake
FAKE_LIVE_PROVIDER_SECRET=segredo-de-teste
LIVE_RECORDING_URL_TTL_SECONDS=600
